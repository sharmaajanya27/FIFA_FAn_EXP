#!/usr/bin/env bash
#
# FanFndr API bootstrap (EC2 cloud-init). Codifies the manual EC2 setup from
# knowledge-base/DEPLOYMENT.md so a fresh instance in any region self-configures
# identically. Rendered by Terraform (templatefile) — $${...} tokens are injected
# at apply time; nginx runtime vars ($host etc.) are inside single-quoted
# heredocs so bash leaves them intact.
set -uxo pipefail
exec > >(tee -a /var/log/user-data.log) 2>&1
echo "=== FanFndr API bootstrap started: $(date -u) ==="

# --- Injected by Terraform -------------------------------------------------
AWS_REGION="${region}"
SSM_PREFIX="${ssm_prefix}"
REPO_URL="${repo_url}"
BRANCH="${branch}"
API_FQDN="${api_fqdn}"
PM2_APP="${pm2_app_name}"
LE_EMAIL="${letsencrypt_email}"
ENABLE_TLS="${enable_tls}"

APP_USER="ec2-user"
APP_HOME="/home/$APP_USER"
REPO_DIR="$APP_HOME/FIFA_FAn_EXP"

run_as_app() { sudo -u "$APP_USER" -H bash -lc "$1"; }

# --- AWS CLI v2 (needed to read SSM params; not preinstalled on AL2023) -----
dnf install -y unzip
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q -o /tmp/awscliv2.zip -d /tmp
/tmp/aws/install --update
export PATH="/usr/local/bin:$PATH"

# --- Base packages: git, nginx, Node 20, PM2, certbot, cron ----------------
dnf update -y
dnf install -y git nginx cronie python3 python3-pip
curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -
dnf install -y nodejs
npm install -g pm2

python3 -m venv /opt/certbot
/opt/certbot/bin/pip install --upgrade pip
/opt/certbot/bin/pip install certbot certbot-nginx
ln -sf /opt/certbot/bin/certbot /usr/bin/certbot

# --- Clone (or update) the repo --------------------------------------------
if [ -d "$REPO_DIR/.git" ]; then
  run_as_app "cd '$REPO_DIR' && git fetch --all && git checkout '$BRANCH' && git pull --ff-only origin '$BRANCH'"
else
  run_as_app "git clone --branch '$BRANCH' '$REPO_URL' '$REPO_DIR'"
fi

# --- Materialize api/.env from SSM SecureString params ----------------------
ENV_FILE="$REPO_DIR/api/.env"
: > "$ENV_FILE"
aws ssm get-parameters-by-path \
  --region "$AWS_REGION" \
  --path "$SSM_PREFIX" \
  --with-decryption --recursive \
  --query "Parameters[].[Name,Value]" --output text |
  while IFS=$'\t' read -r name value; do
    key="$(basename "$name")"
    printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
  done
# Runtime-fixed values (nginx proxies :80/:443 -> :3001).
grep -q '^PORT=' "$ENV_FILE" || echo "PORT=3001" >> "$ENV_FILE"
grep -q '^NODE_ENV=' "$ENV_FILE" || echo "NODE_ENV=production" >> "$ENV_FILE"
chown "$APP_USER:$APP_USER" "$ENV_FILE"
chmod 600 "$ENV_FILE"

# --- Install API dependencies (runs tsx directly, no build step) -----------
run_as_app "cd '$REPO_DIR/api' && npm install"

# --- nginx: minimal main conf + reverse-proxy site -------------------------
cat > /etc/nginx/nginx.conf <<'NGINXMAIN'
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;
    include /etc/nginx/conf.d/*.conf;
}
NGINXMAIN

# Single-quoted heredoc: bash keeps nginx's $vars literal; Terraform still
# injects ${api_fqdn} because it renders the template before bash runs.
cat > /etc/nginx/conf.d/fanfndr.conf <<'NGINXSITE'
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;

server {
    listen 80;
    server_name ${api_fqdn};

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;

    location / {
        limit_req zone=api burst=50 nodelay;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 12M;
    }
}
NGINXSITE

rm -f /etc/nginx/conf.d/default.conf
nginx -t && systemctl enable nginx && systemctl restart nginx

# --- PM2: start the API, persist, and enable start-on-boot -----------------
mkdir -p /var/log/fanfndr
chown "$APP_USER:$APP_USER" /var/log/fanfndr
run_as_app "cd '$REPO_DIR' && pm2 start ecosystem.config.cjs && pm2 save"
env PATH="$PATH:/usr/bin" pm2 startup systemd -u "$APP_USER" --hp "$APP_HOME"
systemctl enable "pm2-$APP_USER" || true

# --- TLS at origin (best effort; nginx :80 already serves the app) ---------
systemctl enable --now crond || true
if [ "$ENABLE_TLS" = "true" ] && [ -n "$LE_EMAIL" ]; then
  for i in $(seq 1 5); do
    if certbot --nginx -d "$API_FQDN" --non-interactive --agree-tos -m "$LE_EMAIL" --redirect; then
      echo "certbot: issued cert for $API_FQDN"
      break
    fi
    echo "certbot attempt $i failed (DNS may not have propagated yet); retrying in 60s"
    sleep 60
  done
  echo "0 0,12 * * * root /usr/bin/certbot renew -q --nginx" > /etc/cron.d/certbot-renew
fi

echo "=== FanFndr API bootstrap finished: $(date -u) ==="
